# Paths used by every script in this repo. Edit here, not in the scripts.

# Local repo (this folder). Kept outside OneDrive and outside ~/.hermes.
HERMES_SYNC_REPO="$HOME/hermes-agents"

# Shared library: templates and published profile copies, readable by the team.
HERMES_SYNC_ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/TRIBE GROUP - TRIBE Group Tech/Hermes"

# Private backup for this machine: memories, souls, databases. Not shared.
HERMES_BACKUP_ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/TRIBE GROUP - samuelkn/Hermes"

# Hermes home for this user. Usually left alone.
# HERMES_HOME="$HOME/.hermes"
