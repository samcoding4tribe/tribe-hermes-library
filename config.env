# Paths used by every script in this repo. Edit here, not in the scripts.

# Local repo (this folder). Kept outside OneDrive and outside ~/.hermes.
HERMES_SYNC_REPO="$HOME/hermes-agents"

# Shared library. OneDrive library root.
HERMES_SYNC_ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/Hermes"
# When the TRIBE Group Tech folder finishes syncing, point the line above at it, e.g.
# HERMES_SYNC_ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/TRIBE GROUP - Share Drive/SYSTEMS/TRIBE Group Tech/Hermes"

# Hermes home for this user. Usually left alone.
# HERMES_HOME="$HOME/.hermes"
