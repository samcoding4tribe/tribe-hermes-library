# Copy this file to config.env in the repo root and fill the three paths for THIS machine.
# Every script in this repo reads paths from here and from nowhere else (D21).

# Local repo (this folder). Kept outside OneDrive and outside ~/.hermes.
# macOS:   $HOME/tribe-hermes-library
# Windows: %USERPROFILE%\tribe-hermes-library
HERMES_SYNC_REPO="$HOME/tribe-hermes-library"

# Shared library: templates, published profile copies, scripts. Readable by the team.
# macOS:   $HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/TRIBE GROUP - TRIBE Group Tech/Hermes Library
# Windows: %USERPROFILE%\OneDrive - TribeTravelandEvents\TRIBE GROUP - TRIBE Group Tech\Hermes Library
HERMES_SYNC_ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/TRIBE GROUP - TRIBE Group Tech/Hermes Library"

# Private backup for this machine: memories, souls, databases. Not shared.
# The last folder is the machine's asset name, never a nickname: it is what tells two
# machines apart in the same cloud drive.
# macOS:   .../TRIBE GROUP - TRIBE Group Tech/Hermes Backups/<machine asset name>
# Windows: ...\TRIBE GROUP - TRIBE Group Tech\Hermes Backups\<machine asset name>
HERMES_BACKUP_ONEDRIVE="$HOME/Library/CloudStorage/OneDrive-TribeTravelandEvents/TRIBE GROUP - TRIBE Group Tech/Hermes Backups/<machine asset name>"

# Hermes home for this user. Usually left alone; the launcher sets HERMES_HOME.
# macOS:   $HOME/.hermes
# Windows: %LOCALAPPDATA%\hermes
# HERMES_HOME="$HOME/.hermes"
